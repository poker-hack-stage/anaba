# ローカル開発: `npm run db:start` 実行後に表示される値をそのまま使える
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<PUBLISHABLE_KEY の値>
# 本番/Preview: Supabase ダッシュボード > Project Settings > API Keys の値を Vercel の環境変数に設定する
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Gemini API（AI旅プラン）。サーバー側だけで使うので NEXT_PUBLIC_ を付けない
#   キーは Google AI Studio（https://aistudio.google.com/apikey）で各自発行する。無料枠で使い、カードは登録しない
#   GEMINI_API_KEY が空なら Gemini を呼ばず、デモモードで候補を作る
#   GEMINI_MODEL を空にすると既定の gemini-3.5-flash-lite を使う（無料枠が1日500回。gemini-3.8-flash は1日20回）
GEMINI_API_KEY=
GEMINI_MODEL=

# 口コミ・スポットの投稿のレート制限（#52）。送信元の IP をこの値と一緒にハッシュにする。サーバー側だけで使うので NEXT_PUBLIC_ を付けない
#   本番（Vercel の Production・Preview）では必須。空だと投稿を受け付けない（503）。`openssl rand -hex 32` などで作る
#   開発（npm run dev）で空なら、開発用の固定の値を使う
RATE_LIMIT_SALT=
